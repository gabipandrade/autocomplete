# PostgreSQL
POSTGRES_DB=justarter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Pool do backend
PGPOOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# GraphQL gateway
GATEWAY_PORT=4000
BACKEND_TIMEOUT_MS=2000

# Frontend
FRONTEND_PORT=5173
VITE_GRAPHQL_URL=http://localhost:4000/
