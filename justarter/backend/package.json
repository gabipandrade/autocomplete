{
  "name": "justarter-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "db:setup": "npm run migrate && npm run seed",
    "lint": "biome lint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.0.1",
    "fastify": "^5.10.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.10",
    "tsx": "^4.17.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  }
}
